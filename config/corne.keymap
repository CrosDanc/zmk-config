#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        // TD(0): Одиночное нажатие - [, двойное - ]

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LBKT>, <&kp RBKT>;
        };
        // Исправленное определение метки hm
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Layer 0

            bindings = <
&kp ESC    &kp Q  &kp W  &kp E      &kp R        &kp T          &kp Y          &kp U        &kp I      &kp O    &kp P     &td0
&kp TAB    &kp A  &kp S  &hm LGUI D &hm LCTRL F  &kp G          &kp H          &hm RCTRL J  &hm RGUI K &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C      &kp V        &kp B          &kp N          &kp M        &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                         &none      &kp LGUI     &lt 1 SPACE    &kp BACKSPACE  &kp RET      &kp DEL
            >;
        };

        lower_layer {
            // Layer 1

            bindings = <
&kp ESC    &kp N1         &kp N2           &kp N3        &kp N4       &kp N5       &kp N6    &kp N7    &kp N8     &kp N9     &kp N0     &kp MINUS
&kp TAB    &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_MINUS  &kp KP_PLUS  &kp EQUAL    &kp HOME  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp END
&kp LSHFT  &none          &none            &none         &none        &none        &none     &kp RBKT  &kp PG_UP  &kp PG_DN  &none      &kp RSHFT
                                           &none         &none        &none        &mo 2     &mo 3     &none
            >;
        };

        raise_layer {
            // Layer 2

            bindings = <
&kp F1     &kp F2      &kp F3        &kp F4        &kp F5  &kp F6    &kp F7  &kp F8    &kp F9      &kp F10     &kp F11  &kp F12
&kp PSCRN  &kp K_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &none   &none     &none   &kp C_PP  &kp C_PREV  &kp C_NEXT  &none    &none
&none      &none       &none         &none         &none   &none     &none   &none     &none       &none       &none    &none
                                     &none         &none   &none     &none   &none     &none
            >;
        };

        numpad_layer {
            // Layer 3

            bindings = <
&none  &none          &none            &none         &none        &none           &none      &kp KP_N7  &kp KP_N8  &kp KP_N9  &none  &none
&none  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_MINUS  &kp KP_PLUS  &kp KP_EQUAL    &none      &kp KP_N4  &kp KP_N5  &kp KP_N6  &none  &none
&none  &none          &none            &none         &none        &kp KP_COMMA    &kp KP_N0  &kp KP_N1  &kp KP_N2  &kp KP_N3  &none  &none
                                       &none         &none        &none           &none      &none      &none
            >;
        };
    };
};
