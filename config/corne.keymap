#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        // Логика Tap Dance: нажатие = Backspace, двойное нажатие = Delete
        td_bs_del: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp BSPC>, <&kp DEL>;
        };

        // Настройка Mod-Tap для более четкой печати (флавор balanced)
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Базовый слой с вашими Mod-Tap на D, F, J, K
            bindings = <
&kp TAB   &kp Q       &kp W       &kp E        &kp R         &kp T        &kp Y   &kp U         &kp I        &kp O       &kp P          &kp MINUS
&kp ESC   &kp A       &kp S       &hm LGUI D   &hm LCTRL F   &kp G        &kp H   &hm RCTRL J   &hm RGUI K   &kp L       &kp SEMI       &kp SQT
&kp LSHFT &kp Z       &kp X       &kp C        &kp V         &kp B        &kp N   &kp M         &kp COMMA    &kp DOT     &kp FSLH       &kp RSHFT
                                  &kp LALT     &lt 1 SPACE   &kp LGUI     &kp RET &lt 2 BSPC    &td_bs_del
            >;
        };

        lower_layer {
            // Слой с цифрами и символами
            bindings = <
&kp ESC    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8   &kp N9   &kp N0   &kp BSPC
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LFT  &kp DWN  &kp UP   &kp RGT  &none    &none
&kp LSHFT  &none        &none        &none        &none        &none          &none    &none    &none    &none    &none    &none
                                     &kp LALT     &trans       &kp LGUI       &kp RET  &trans   &kp DEL
            >;
        };

        raise_layer {
            // Слой управления и ZMK Studio
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6     &kp F7   &kp F8   &kp F9   &kp F10  &kp F11  &kp F12
&none   &none   &none   &none   &none   &none      &none    &none    &none    &none    &none    &none
&none   &none   &none   &none   &none   &none      &none    &none    &none    &none    &none    &none
                        &trans  &trans  &trans     &trans   &trans   &trans
            >;
        };
    };
};
